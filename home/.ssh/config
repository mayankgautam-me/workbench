# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config


# Raspberry Pi and Jetson behind the "Office Router" Cloudflare tunnel, through Cloudflare Access.
Host raspberry
  HostName raspberry-access.fabloq.com

Host jetson
  HostName jetson-access.myndrya.com

Host raspberry jetson raspberry-access.fabloq.com jetson-access.myndrya.com
  User fabrolabs
  ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
  AddKeysToAgent yes
  UseKeychain yes
  ForwardAgent yes
